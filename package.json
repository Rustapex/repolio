{
  "name": "repolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync": "node scripts/sync-repositories.mjs",
    "validate:groups": "node scripts/validate-groups.mjs",
    "typecheck": "tsc --noEmit",
